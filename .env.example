# ── Microsoft Azure / Bookings ──────────────────────────────────────────────
# See README.md for step-by-step instructions to get these values.

# From your Azure App Registration → Overview
AZURE_CLIENT_ID=your-azure-client-id-here

# From your Azure App Registration → Certificates & secrets → New client secret
AZURE_CLIENT_SECRET=your-azure-client-secret-here

# Your Azure AD tenant ID (from Azure Portal → Azure Active Directory → Overview)
AZURE_TENANT_ID=your-azure-tenant-id-here

# Your Microsoft Bookings business ID
# Find it at: https://graph.microsoft.com/v1.0/solutions/bookingBusinesses
# (after granting BookingsAppointment.ReadAll permission)
BOOKING_BUSINESS_ID=your-booking-business-id-here

# ── Anthropic ────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-your-key-here

# ── Email (for sending guides to volunteer groups) ───────────────────────────
# Gmail: use an App Password (not your regular password)
# Create one at: myaccount.google.com/apppasswords
EMAIL_FROM=your-rmh-coordinator-email@gmail.com
EMAIL_PASSWORD=your-gmail-app-password
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587